# syntax=docker/dockerfile:1.7

# Dashboard-enabled distribution: one Tay Engine, the executor socket, and UI.
ARG ELIXIR_VERSION=1.20.2
ARG OTP_VERSION=29.0.3
ARG DEBIAN_VERSION=trixie-20260623-slim
ARG BUILDER_IMAGE=hexpm/elixir:${ELIXIR_VERSION}-erlang-${OTP_VERSION}-debian-${DEBIAN_VERSION}
ARG RUNNER_IMAGE=debian:${DEBIAN_VERSION}

FROM ${BUILDER_IMAGE} AS build

RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential ca-certificates git \
    && rm -rf /var/lib/apt/lists/*

ENV MIX_ENV=prod
WORKDIR /build

RUN mix local.hex --force && mix local.rebar --force

COPY mix.exs mix.lock ./
COPY config ./config
COPY c_src ./c_src
COPY standalone/mix.exs standalone/mix.lock standalone/
COPY standalone/config standalone/config
COPY dashboard/mix.exs dashboard/mix.lock dashboard/
COPY dashboard/config dashboard/config
COPY dashboard/standalone/mix.exs dashboard/standalone/mix.lock dashboard/standalone/
COPY dashboard/standalone/config dashboard/standalone/config

WORKDIR /build/dashboard/standalone
RUN mix deps.get --only prod --check-locked

WORKDIR /build
COPY lib ./lib
COPY standalone/lib standalone/lib
COPY dashboard/lib dashboard/lib
COPY dashboard/standalone/lib dashboard/standalone/lib

WORKDIR /build/dashboard/standalone
RUN mix compile --warnings-as-errors && mix release tay_dashboard_standalone

FROM ${RUNNER_IMAGE} AS runtime

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates libsctp1 libstdc++6 libssl3 ncurses-base \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --system --gid 10001 tay \
    && useradd --system --uid 10001 --gid tay --home-dir /opt/tay --shell /usr/sbin/nologin tay \
    && install -d -o tay -g tay -m 0770 /var/lib/tay /run/tay \
    && install -d -o tay -g tay -m 0700 /tmp/tay

WORKDIR /opt/tay
COPY --from=build --chown=tay:tay /build/dashboard/standalone/_build/prod/rel/tay_dashboard_standalone ./

USER 10001:10001

ENV HOME=/tmp/tay \
    RELEASE_TMP=/tmp/tay \
    ERL_CRASH_DUMP=/tmp/tay/erl_crash.dump \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    ELIXIR_ERL_OPTIONS=+fnu \
    TAY_DATA_DIR=/var/lib/tay \
    TAY_SOCKET_PATH=/run/tay/tay.sock \
    TAY_INITIALIZE_IF_MISSING=false \
    TAY_DASHBOARD_HOST=localhost \
    TAY_DASHBOARD_PORT=4000

VOLUME ["/var/lib/tay", "/run/tay"]
EXPOSE 4000

HEALTHCHECK --interval=5s --timeout=3s --start-period=5s --retries=12 \
  CMD ["bin/tay_dashboard_standalone", "rpc", "Tay.Standalone.Health.check!()"]

ENTRYPOINT ["/opt/tay/bin/tay_dashboard_standalone"]
CMD ["start"]
